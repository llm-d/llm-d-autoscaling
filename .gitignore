# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
main
bin/
.vscode/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Kind config file
kind-config.yaml

# Kubernetes manifests
gpu.cluster

# Miscellaneous
.DS_Store
~*

# llm-d and llm-d-infra directories
llm-d/
llm-d-infra/
llm-d-benchmark/
benchmark/hack/.venv/
benchmark/hack/.port-forward-state.json
# llmdbenchmark workspace directories (created by benchmark runs)
*-*-*-*-*-*/
biran-*/
llmd/
llmd-infra/

# Per-session kubeconfig (embeds a live cluster token) and raw setup command
# capture logs (which duplicate that token via `oc config view`) -- never
# commit these, unlike the rest of benchmark/results/.
benchmark/results/*/environment/
benchmark/results/*/setup/commands/
benchmark/results/*/logs/
benchmark/results/*/plan/

*.tgz
actionlint

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Generated TLS certificates (auto-created by e2e test setup)
legacy/hack/tls-certs/

# AI
.claude/worktrees/
.envrc
