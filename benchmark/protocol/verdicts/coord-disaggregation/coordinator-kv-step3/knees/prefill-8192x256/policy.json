{
  "autoscaler": {
    "hpa_by_role": {
      "prefill": {
        "sync_period_s": 15,
        "tolerance": 0.1,
        "min_replicas": 1,
        "max_replicas": 1,
        "metrics_delay_s": 0.0,
        "polling_interval_s": 15,
        "fallback": {
          "failure_threshold": 3,
          "replicas": 1,
          "behavior": "currentReplicas"
        },
        "behavior": {
          "scale_up": {
            "stabilization_window_s": 0,
            "policies": [
              {
                "type": "Pods",
                "value": 1,
                "period_s": 180
              }
            ]
          },
          "scale_down": {
            "stabilization_window_s": 300,
            "policies": [
              {
                "type": "Pods",
                "value": 1,
                "period_s": 300
              }
            ]
          }
        },
        "triggers": [
          {
            "name": "prefill-uncached-prompt-tokens",
            "target_type": "AverageValue",
            "target": 7782.0,
            "terms": [
              {
                "metric": "prefill_prompt_tokens",
                "function": "rate",
                "window_s": 120
              }
            ]
          }
        ]
      },
      "decode": {
        "sync_period_s": 15,
        "tolerance": 0.1,
        "min_replicas": 4,
        "max_replicas": 4,
        "metrics_delay_s": 0.0,
        "polling_interval_s": 15,
        "fallback": {
          "failure_threshold": 3,
          "replicas": 1,
          "behavior": "currentReplicas"
        },
        "behavior": {
          "scale_up": {
            "stabilization_window_s": 0,
            "policies": [
              {
                "type": "Pods",
                "value": 4,
                "period_s": 60
              }
            ]
          },
          "scale_down": {
            "stabilization_window_s": 300,
            "policies": [
              {
                "type": "Pods",
                "value": 1,
                "period_s": 300
              }
            ]
          }
        },
        "triggers": [
          {
            "name": "decode-kv-usage-2m",
            "target_type": "AverageValue",
            "target": 0.45,
            "terms": [
              {
                "metric": "kv_usage",
                "aggregation": "sum",
                "role": "decode",
                "function": "avg_over_time",
                "window_s": 120
              }
            ]
          },
          {
            "name": "decode-waiting-alarm",
            "target_type": "AverageValue",
            "target": 5.0,
            "terms": [
              {
                "metric": "waiting",
                "aggregation": "sum",
                "role": "decode"
              }
            ]
          }
        ]
      }
    }
  },
  "instance_lifecycle": {
    "loading_delay": {
      "mean": 120.0,
      "stddev": 0
    }
  },
  "signals": {
    "scrape_interval_s": 30.0
  }
}
